# CCTV data collection
ITS_API_KEY=
UTIC_API_KEY=
UTIC_KEY=

# Highway traffic (proxy /highway-traffic). Empty -> public demo key "test".
EX_API_KEY=
HIGHWAY_TRAFFIC_TTL_SECONDS=180

# Optional World Tour providers. Windy is bounded and remains source-only
# until independent in-app playback verification succeeds. OpenWebcamDB stays
# disabled unless its aggregation terms and attribution requirements are approved.
WINDY_WEBCAMS_API_KEY=
OPENWEBCAMDB_API_KEY=
# YouTube collection currently works without this key via yt-dlp live search.
YOUTUBE_DATA_API_KEY=

# Proxy / deployment
CCTV_PUBLIC_PROXY_BASE=https://158.179.194.163.sslip.io
CCTV_WORKER_PROXY_BASE=https://cctv-proxy.pyw213.workers.dev
CCTV_PROXY_BASES=https://158.179.194.163.sslip.io,https://cctv-proxy.pyw213.workers.dev

# Server tuning
HLS_DIR=/tmp/hls
IDLE_TIMEOUT=30
MAX_STREAMS=2
Z3_LOCAL_CACHE_FILE=data/z3_cache.json
Z3_CACHE_TTL_MINUTES=15
Z3_CACHE_STALE_HOURS=0.75
JEJU_ID_MAP_PATH=data/jeju_id_map.json
CCTV_DISABLE_STARTUP_JOBS=0

# Optional quality endpoints.
# The cctv-quality Worker is not deployed (2026-11-22), so leave these empty:
# the quality views fall back to data/quality_summary.json and no telemetry is sent.
CCTV_QUALITY_TELEMETRY_ENDPOINT=
CCTV_QUALITY_SUMMARY_URL=
CCTV_CANARY_STATUS_URL=https://158.179.194.163.sslip.io/canary-status

# Legacy aliases kept for compatibility
PUBLIC_PROXY_BASE_URL=
WORKER_PROXY_BASE_URL=
