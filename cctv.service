[Unit]
Description=CCTV Gunicorn Proxy
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/cctv
ExecStart=/home/ubuntu/cctv/venv/bin/gunicorn --workers 4 --worker-class gevent --bind 0.0.0.0:8080 --timeout 120 server.app:app
Restart=always

[Install]
WantedBy=multi-user.target
